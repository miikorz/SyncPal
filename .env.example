# PostgreSQL
DATABASE_URL="postgresql://syncpal:syncpal@localhost:5432/syncpal?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Data retention
DATA_RETENTION_DAYS="90"

# Required when the web app or worker runs outside Shopify CLI.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""
SCOPES="read_orders,read_fulfillments"

# PayPal Partner. Select independently of NODE_ENV or hosting location.
# Use separate credentials, PostgreSQL databases and Redis instances for Sandbox and Live.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_PARTNER_ATTRIBUTION_ID=""

# Optional explicit test-order bindings. Empty in Live; never maps real Shopify orders.
# JSON array of {shopDomain, shopifyOrderId, paypalMerchantId, captureId}.
PAYPAL_SANDBOX_ORDER_BINDINGS=""

# 32-byte key encoded as 64 hexadecimal characters.
PAYPAL_TOKEN_ENCRYPTION_KEY=""
