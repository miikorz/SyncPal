# PostgreSQL
DATABASE_URL="postgresql://syncpal:syncpal@localhost:5432/syncpal?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Required when the web app or worker runs outside Shopify CLI.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""
SCOPES="read_orders"

# PayPal OAuth
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"

# 32-byte key encoded as 64 hexadecimal characters.
PAYPAL_TOKEN_ENCRYPTION_KEY=""
